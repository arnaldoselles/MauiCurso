<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiCurso.Pages.DetalleHimnoPage"
             BackgroundImageSource="background.png">
    <Grid RowDefinitions="Auto,*,Auto" Padding="10" RowSpacing="10">

        <!-- HEADER -->
        <Frame Grid.Row="0"
               CornerRadius="15"
               Padding="15"
               HasShadow="True">
            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding HimnoSeleccionado.Numero, StringFormat='Himno #{0}'}"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="Chocolate" />

                <Label Text="{Binding HimnoSeleccionado.Nombre}"
                       FontSize="25"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="Chocolate" />
            </VerticalStackLayout>
        </Frame>

        <!-- LETRA DEL HIMNO -->
        <ScrollView Grid.Row="1">
            <Frame BackgroundColor="White"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#D6C7A1">
                <Label Text="{Binding HimnoSeleccionado.Letra}"
                       FontSize="{Binding FontSize}"
                       CharacterSpacing="0.5"
                       LineBreakMode="WordWrap"
                       TextColor="#3A2F1B"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="Start"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Start" />
            </Frame>
        </ScrollView>

        <!-- BARRA INFERIOR -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Padding="5">

            <!-- Botón Volver centrado respecto al himno -->
            <Button Text="←Volver al índice"
                    Command="{Binding VolverCommand}"
                    BackgroundColor="#0077FF"
                    TextColor="White"
                    CornerRadius="12"
                    Padding="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    Grid.Column="1"
                    HorizontalOptions="Center" />

            <!-- Botones A+ y A- a la derecha -->
            <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="End"
                                   Grid.Column="2">
                <Button Text="A+" Command="{Binding AumentarLetraCommand}"
                        WidthRequest="35" HeightRequest="35"
                        FontSize="12" CornerRadius="8"
                        BackgroundColor="#0077FF" TextColor="White" 
                        FontAttributes="Bold"/>
                <Button Text="A-" Command="{Binding DisminuirLetraCommand}"
                        WidthRequest="35" HeightRequest="35"
                        FontSize="12" CornerRadius="8"
                        BackgroundColor="#0077FF" TextColor="White" 
                        FontAttributes="Bold"/>
            </HorizontalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
