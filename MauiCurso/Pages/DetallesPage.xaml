<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiCurso.DetallesPage"
             BackgroundImageSource="background.png"
             >

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="10">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Indice"
                   FontSize="35"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" 
                   TextColor="Chocolate"
                   />

            <!-- Buscador -->
            <Frame CornerRadius="12" 
                   Padding="0" 
                   BorderColor="Transparent"
                   BackgroundColor="White"
                   HasShadow="True">
                <Grid ColumnDefinitions="*,Auto" Padding="10" ColumnSpacing="10">
                    <Entry Grid.Column="0"
                           Placeholder="Buscar himno por nombre o número..."
                           Text="{Binding TextoBusqueda}"
                           BackgroundColor="Transparent"
                           FontSize="14" />
                    <Button Grid.Column="1"
                            Text="X"
                            Command="{Binding LimpiarBusquedaCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#007AFF"
                            WidthRequest="40"
                            HeightRequest="40"
                            BorderWidth="2"
                            BorderColor="#007AFF"
                            FontSize="20"
                            CornerRadius="20"
                            Padding="0" />
                </Grid>
            </Frame>

            <!--<Button Text="Recargar"
                    Command="{Binding CargarHimnosCommand}"
                    BackgroundColor="#0077FF"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="15" />-->

            <Label Text="No hay himnos guardados"
                   FontSize="16"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   IsVisible="{Binding NoHayHimnos}" />
        </VerticalStackLayout>

        <!-- Lista con scroll -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Himnos}" 
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="15"
                           Padding="15"
                           Margin="0,5"
                           BackgroundColor="#F5F5F5"
                           BorderColor="#E0E0E0">
                        <VerticalStackLayout Spacing="8">
                            <!--<VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleHimnoCommand}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>-->

                            <Label Text="{Binding Numero, StringFormat='Himno #{0}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="Chocolate"/>
                            <Label Text="{Binding Nombre, StringFormat='♪ {0}'}"
                                   FontSize="18"
                                   TextColor="#3A2F1B"
                                   HorizontalTextAlignment="Center"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Letra}"
                                   FontSize="14"
                                   TextColor="#3A2F1B"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2" />
                            <BoxView HeightRequest="1"
                                   BackgroundColor="#3A2F1B"
                                   Margin="0,5"
                                   Opacity="0.4"
                                   />
                            <Button Text="Ver letra completa"
                                   Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleHimnoCommand}"
                                   CommandParameter="{Binding .}"
                                   BackgroundColor="Transparent"
                                   TextColor="#007AFF"
                                   BorderColor="#007AFF"
                                   BorderWidth="2"
                                   CornerRadius="12"
                                   Padding="10,5"
                                   Margin="0,5,0,0"
                                   HorizontalOptions="Center"
                                   WidthRequest="150"
                                   HeightRequest="35"
                                   FontSize="13"/>        

                            <!--<Button Text="Eliminar"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarHimnoCommand}"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#FF6B6B"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,5,0,0" 
                                    FontAttributes="Bold"/>-->
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Footer -->
        <Button Grid.Row="2"
        Text="+"
        FontAttributes="Bold"
        FontSize="40"
        WidthRequest="65"
        HeightRequest="65"
        CornerRadius="33"
        BackgroundColor="#007AFF"
        TextColor="White"
        HorizontalOptions="End"
        VerticalOptions="End"
        Margin="0,0,10,0"
        Padding="0" 
        Command="{Binding IrANuevoHimnoCommand}" />

    </Grid>

</ContentPage>