<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiCurso.DetallesPage"
             BackgroundImageSource="background.png"
             >
    <Grid RowDefinitions="Auto,*,Auto" Padding="10" RowSpacing="2">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Label Text="Indice"
                   FontSize="35"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" 
                   TextColor="Chocolate"
                   />

            <!-- Buscador -->
            <Frame CornerRadius="10" 
       Padding="0"
       BackgroundColor="White"
       HasShadow="True">

                <Grid ColumnDefinitions="*,Auto" Padding="6" ColumnSpacing="8">

               <Entry Grid.Column="0"
               Placeholder="Buscar himno por nombre o número..."
               Text="{Binding TextoBusqueda}"
               BackgroundColor="Transparent"
               TextColor="Black"
               FontSize="13" />

                    <Button Grid.Column="1"
                Text="X"
                Command="{Binding LimpiarBusquedaCommand}"
                BackgroundColor="Transparent"
                TextColor="#007AFF"
                WidthRequest="30"
                HeightRequest="30"
                BorderWidth="2"
                BorderColor="#007AFF"
                FontSize="12"
                FontAttributes="Bold"
                CornerRadius="20"
                Padding="0" />
                </Grid>
            </Frame>

            <Label Text="No hay himnos guardados"
                   FontSize="16"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   IsVisible="{Binding NoHayHimnos}" />
        </VerticalStackLayout>

        <!-- Lista con scroll -->
        <CollectionView x:Name="HimnosCollectionView" Grid.Row="1" 
                ItemsSource="{Binding Himnos}" 
                SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="4"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="12"
                   Padding="8"
                   Margin="0,3"
                   BackgroundColor="#99FFFFFF"
                   BorderColor="#E0E0E0">

                        <VerticalStackLayout Spacing="4">

                            <Label Text="{Binding Numero, StringFormat='Himno #{0}'}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="Chocolate"/>

                            <Label Text="{Binding Nombre, StringFormat='♪ {0}'}"
                           FontSize="15"
                           TextColor="#3A2F1B"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />

                            <Label Text="{Binding Letra}"
                           FontSize="12"
                           TextColor="#3A2F1B"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- Botón centrado -->
                                <Button Grid.Column="0"
                            Text="Ver letra completa"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleHimnoCommand}"
                            CommandParameter="{Binding .}"
                            BackgroundColor="Transparent"
                            TextColor="#007AFF"
                            BorderColor="#007AFF"
                            BorderWidth="1"
                            CornerRadius="10"
                            Padding="4"
                            Margin="0,4,0,0"
                            HorizontalOptions="Center"
                            WidthRequest="110"
                            HeightRequest="28"
                            FontSize="11"/>

                                <!-- Botón eliminar pequeño -->
                                <ImageButton Grid.Column="1"
                                 Source="delete.png"
                             WidthRequest="28"
                             HeightRequest="28"
                             BackgroundColor="Transparent"
                             Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarHimnoCommand}"
                             CommandParameter="{Binding Id}"
                             IsEnabled="{Binding Numero, Converter={StaticResource MayorQue192Converter}}"
                             Opacity="{Binding Numero, Converter={StaticResource MayorQue192Converter}, ConverterParameter=Opacity}" />

                            </Grid>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Botones flotantes para desplazar la lista por 10 items -->
        <VerticalStackLayout Grid.Row="1"
                             HorizontalOptions="End"
                             VerticalOptions="End"
                             Margin="0,0,4,55"
                             Spacing="8">
            <Button Text="▲"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    Clicked="ScrollLinesUp_Clicked"/>
            <Button Text="▼"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    Clicked="ScrollLinesDown_Clicked"/>
        </VerticalStackLayout>

        <!-- Footer -->
        <Button Grid.Row="2"
        Text="+"
        FontAttributes="Bold"
        FontSize="30"
        WidthRequest="45"
        HeightRequest="45"
        CornerRadius="33"
        BackgroundColor="#007AFF"
        TextColor="White"
        HorizontalOptions="End"
        VerticalOptions="End"
        Margin="0,0,4,0"
        Padding="0" 
        Command="{Binding IrANuevoHimnoCommand}" />

    </Grid>

</ContentPage>